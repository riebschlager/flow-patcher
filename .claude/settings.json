{
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm e2e)",
      "Bash(pnpm e2e *)",
      "Bash(pnpm run-patch *)",
      "Bash(pnpm dev)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec playwright test *)",
      "Bash(git *)",
      "Read(../flow/**)",
      "mcp__playwright"
    ],
    "ask": [
      "Bash(pnpm golden:update)",
      "Bash(pnpm install *)",
      "Bash(pnpm i *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm exec playwright install *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git clone *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch"
    ],
    "deny": [
      "Edit(../flow/**)"
    ]
  },
  "enabledMcpjsonServers": ["playwright"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-paths.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-changed.mjs\"",
            "timeout": 60,
            "statusMessage": "Typechecking"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-before-stop.mjs\"",
            "timeout": 300,
            "statusMessage": "Running pnpm check"
          }
        ]
      }
    ]
  }
}
